# /home/ubuntu/avrg-site/contact/.env on Lightsail — chmod 600, never committed.
# systemd reads it (EnvironmentFile); values are NOT quoted.

# Random secret that signs the form's timestamp token. Generate once:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CONTACT_SECRET=CHANGE_ME

# SES send-only IAM user avrg-contact-sender (policy: ses:SendEmail on the
# av-research-group.net identity in us-west-2, FromAddress contact@ only).
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=us-west-2

CONTACT_TO=judy@av-research-group.net
CONTACT_FROM=contact@av-research-group.net
CONTACT_DAILY_CAP=50

# 1 = log messages instead of sending (use until the SES key is in place).
CONTACT_DRY_RUN=1
